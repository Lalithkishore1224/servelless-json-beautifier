{
	"name": "JSON Beautifier",
	"image": "mcr.microsoft.com/devcontainers/python:1-3.12",
	"customizations": {
		"vscode": {
			"settings": {},
			"extensions": []
		}
	},
	"forwardPorts": [9000],
	"portsAttributes": {
		"9000": {
			"label": "App",
			"visibility": "public",
			"onAutoForward": "openBrowser"
		}
	},
	"postCreateCommand": "pip3 install -r requirements.txt",
	"postStartCommand": "nohup python -m flask run --host 0.0.0.0 --port 9000 --no-debugger --no-reload > /tmp/app.log 2>&1 &"
}
